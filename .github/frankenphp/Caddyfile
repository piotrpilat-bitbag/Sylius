# FrankenPHP configuration for a CI job measuring request isolation.
#
# The three settings below are not cosmetic — without them, the measurement stops
# working and no one notices because the test suite stays green.
#
#   worker … 1          A SINGLE worker. With multiple workers, consecutive requests
#                       land in different processes and leaked state appears random.
#   FRANKENPHP_LOOP_MAX Set in env to -1. The default of 500 restarts the process
#                       every 500 requests, wiping the trace. Worker recycling does
#                       NOT fix correctness bugs; it only masks the memory symptom.
#   APP_ENV=prod        In dev, the profiler and debug container introduce their own
#                       per-request state and drown out the signal.

{
	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		worker {$APP_PATH:/app}/public/index.php {$FRANKENPHP_WORKERS:1}
	}
}

{$SERVER_NAME:http://localhost:8080} {
	log {
		format console
		level ERROR
	}

	root {$APP_PATH:/app}/public
	encode zstd br gzip

# Allows each response to report which mode it was generated in — useful
# when a scenario fails and you need to verify if worker mode was actually being measured.

	header X-Franken-Worker "{$WORKER_MODE_HEADER:1}"

	php_server {
		index index.php
	}
}
